<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">
  <Identity
    Name="Cloudfyy.QiQiImeUwpSearchHost"
    Publisher="CN=QiQiIME Development"
    Version="0.1.0.0"
    ProcessorArchitecture="x64" />
  <mp:PhoneIdentity
    PhoneProductId="5B806BE3-3C20-4D2E-BF8F-D0DCDCBCE1DA"
    PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>QiQiIME UWP Search Host</DisplayName>
    <PublisherDisplayName>cloudfyy</PublisherDisplayName>
    <Description>Minimal AppContainer host for QiQiIME input and Search Contract testing.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Universal"
      MinVersion="10.0.18362.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="zh-cn" />
  </Resources>
  <Applications>
    <Application
      Id="App"
      Executable="QiQiImeUwpSearchHost.exe"
      EntryPoint="QiQiImeUwpSearchHost.App">
      <uap:VisualElements
        DisplayName="QiQiIME UWP Search Host"
        Description="Minimal AppContainer host for QiQiIME testing."
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        BackgroundColor="#1F1F1F">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen
          Image="Assets\SplashScreen.png"
          BackgroundColor="#1F1F1F" />
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.search" />
      </Extensions>
    </Application>
  </Applications>
</Package>

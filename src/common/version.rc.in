#include <winresrc.h>

#pragma code_page(65001)

// Brand icon (used by ITfInputProcessorProfiles::AddLanguageProfile in Win+Space switcher)
1 ICON "@QIQI_RESOURCE_ICON@"

// Localized string table for ITfInputProcessorProfileMgr::RegisterProfile
STRINGTABLE LANGUAGE 0x04, 0x02
BEGIN
    100 "奇奇五笔"
END

STRINGTABLE LANGUAGE 0x09, 0x01
BEGIN
    100 "QiQi Wubi"
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@QIQIIME_VERSION_TWEAK@
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@QIQIIME_VERSION_TWEAK@
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @QIQI_RESOURCE_FILE_TYPE@
 FILESUBTYPE @QIQI_RESOURCE_FILE_SUBTYPE@
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "Comments", "@QIQI_RESOURCE_COMMENTS@"
            VALUE "CompanyName", "cloudfyy (https://github.com/cloudfyy/qiqiime)"
            VALUE "FileDescription", "@QIQI_RESOURCE_DESCRIPTION@"
            VALUE "FileVersion", "@QIQIIME_FULL_VERSION@"
            VALUE "InternalName", "@QIQI_RESOURCE_FILENAME@"
            VALUE "LegalCopyright", "Copyright (C) 2026 cloudfyy. Released under the GPL License."
            VALUE "LegalTrademarks", "奇奇五笔 (QiQiIME)"
            VALUE "OriginalFilename", "@QIQI_RESOURCE_FILENAME@"
            VALUE "ProductName", "奇奇五笔 (QiQi Wubi IME)"
            VALUE "ProductVersion", "@QIQIIME_FULL_VERSION@"
        END
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "@QIQI_RESOURCE_COMMENTS@"
            VALUE "CompanyName", "cloudfyy (https://github.com/cloudfyy/qiqiime)"
            VALUE "FileDescription", "@QIQI_RESOURCE_DESCRIPTION@"
            VALUE "FileVersion", "@QIQIIME_FULL_VERSION@"
            VALUE "InternalName", "@QIQI_RESOURCE_FILENAME@"
            VALUE "LegalCopyright", "Copyright (C) 2026 cloudfyy. Released under the GPL License."
            VALUE "LegalTrademarks", "奇奇五笔 (QiQiIME)"
            VALUE "OriginalFilename", "@QIQI_RESOURCE_FILENAME@"
            VALUE "ProductName", "奇奇五笔 (QiQi Wubi IME)"
            VALUE "ProductVersion", "@QIQIIME_FULL_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200, 0x0409, 1200
    END
END

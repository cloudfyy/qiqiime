  <String Id="DictManagerShortcutName" Value="奇奇五笔词典管理器" />
  <String Id="DictManagerShortcutDescription" Value="管理奇奇五笔用户词条与词库备份。" />
  <String Id="LogMonitorShortcutName" Value="奇奇五笔日志监视器" />

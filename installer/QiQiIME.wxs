<?xml version="1.0" encoding="UTF-8"?>
<!--
  SPDX-FileCopyrightText: 2026 cloudfyy
  SPDX-License-Identifier: GPL-3.0-or-later
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?if $(sys.BUILDARCH) = x64 ?>
    <?define UpgradeCode = "8E7B9D31-5A42-4C81-9F11-202610299999" ?>
    <?define ComponentGuidPrefix = "8E7B9D31-5A42-4C81-9F11-20261029" ?>
    <?define ProgramFilesDirectory = "ProgramFiles64Folder" ?>
    <?define NativeSystemDirectory = "System64Folder" ?>
    <?define NativeDirectory = "DirX64" ?>
    <?define NativeFileSuffix = "X64" ?>
    <?define ShortcutBitness = "always64" ?>
  <?elseif $(sys.BUILDARCH) = x86 ?>
    <?define UpgradeCode = "8E7B9D31-5A42-4C81-9F11-202611119999" ?>
    <?define ComponentGuidPrefix = "8E7B9D31-5A42-4C81-9F11-20261111" ?>
    <?define ProgramFilesDirectory = "ProgramFilesFolder" ?>
    <?define NativeSystemDirectory = "SystemFolder" ?>
    <?define NativeDirectory = "DirX86" ?>
    <?define NativeFileSuffix = "X86" ?>
    <?define ShortcutBitness = "always32" ?>
  <?else?>
    <?error Unsupported MSI architecture ?>
  <?endif?>
  <Package Name="!(loc.ProductName)"
           Manufacturer="cloudfyy"
           Version="$(var.ProductVersion)"
           UpgradeCode="$(var.UpgradeCode)"
           Scope="perMachine"
           Language="$(var.ProductLcid)"
           Codepage="65001">

    <SummaryInformation Description="!(loc.SummaryDescription)"
                        Manufacturer="cloudfyy (https://github.com/cloudfyy/qiqiime)"
                        Comments="!(loc.SummaryComments)"
                        Keywords="!(loc.SummaryKeywords)"
                        Codepage="$(var.SummaryCodepage)" />

    <Icon Id="ProductIcon" SourceFile="data\qiqiime-settings.ico" />
    <Icon Id="DictManagerIcon" SourceFile="data\qiqiime-dict.ico" />
    <Icon Id="LogMonitorIcon" SourceFile="data\qiqiime-monitor.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
    <Property Id="ARPCOMMENTS" Value="!(loc.SummaryComments)" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/cloudfyy/qiqiime" />
    <Property Id="ARPHELPLINK" Value="https://github.com/cloudfyy/qiqiime" />

    <!-- Keep Restart Manager active (RmGetList takes ~10ms) to avoid falling back to the legacy
         NT4 Perflib("740") CDetectAppsNT 50KB-step loop (which takes 2.5-5+ minutes when qiqiime.dll is mapped),
         while disabling automatic process shutdown/restart and skipping System Restore point creation. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="DisableShutdown" />
    <Property Id="MSIRMSHUTDOWN" Value="2" />
    <Property Id="MSIDISABLERMRESTART" Value="1" />
    <Property Id="MSIFASTINSTALL" Value="7" />
    <Property Id="REBOOT" Value="ReallySuppress" />
    <Property Id="QIQI_REMOVE_USER_DATA" Secure="yes" />

    <UI>
      <TextStyle Id="UninstallFont" FaceName="Segoe UI" Size="9" />
      <Property Id="DefaultUIFont" Value="UninstallFont" />
      <Dialog Id="UninstallDataDlg" Width="370" Height="220" Title="!(loc.ProductName)">
        <Control Id="Description" Type="Text" X="20" Y="20" Width="330" Height="45"
                 Text="!(loc.UninstallDescription)" />
        <Control Id="RemoveData" Type="CheckBox" X="20" Y="75" Width="330" Height="30"
                 Property="QIQI_REMOVE_USER_DATA" CheckBoxValue="1" Text="!(loc.RemoveUserData)" />
        <Control Id="Warning" Type="Text" X="20" Y="115" Width="330" Height="50"
                 Text="!(loc.RemoveUserDataWarning)" />
        <Control Id="Remove" Type="PushButton" X="200" Y="185" Width="75" Height="23"
                 Default="yes" Text="!(loc.UninstallButton)">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="280" Y="185" Width="70" Height="23"
                 Cancel="yes" Text="!(loc.CancelButton)">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>
    </UI>
    <InstallUISequence>
      <Show Dialog="UninstallDataDlg" Before="ExecuteAction"
            Condition="Installed AND REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallUISequence>

    <MajorUpgrade DowngradeErrorMessage="!(loc.DowngradeErrorMessage)" />
    <?if $(sys.BUILDARCH) = x86 ?>
      <Launch Condition="Installed OR NOT VersionNT64" Message="!(loc.X86Requires32BitWindows)" />
    <?endif?>
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="$(var.ProgramFilesDirectory)">
      <Directory Id="INSTALLFOLDER" Name="QiQiIME">
        <?if $(sys.BUILDARCH) = x64 ?>
        <Directory Id="DirX64" Name="x64" />
        <?endif?>
        <Directory Id="DirX86" Name="x86" />
        <Directory Id="DirData" Name="data" />
        <Directory Id="DirScripts" Name="scripts" />
        <Directory Id="DirLicenses" Name="licenses" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="QiQiProgramMenuFolder" Name="QiQiIME" />
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents">
      <!-- 64-bit TSF DLL and standalone GUI tools -->
      <?if $(sys.BUILDARCH) = x64 ?>
      <Component Id="CmpDllX64" Directory="DirX64" Guid="8E7B9D31-5A42-4C81-9F11-202610290101">
        <File Id="FileDllX64" Source="$(var.StageDir)\x64\qiqiime.dll" KeyPath="yes" />
        <File Id="FileSettingsExeX64" Source="$(var.StageDir)\x64\QiQiIMESettings.exe" />
        <File Id="FileLogMonitorExeX64" Source="$(var.StageDir)\x64\QiQiIMELogMonitor.exe" />
        <File Id="FileDictManagerExeX64" Source="$(var.StageDir)\x64\QiQiIMEDictManager.exe" />
      </Component>
      <?endif?>

      <!-- Native x86 or WOW64 TSF DLL and standalone GUI tools -->
      <Component Id="CmpDllX86" Directory="DirX86" Guid="$(var.ComponentGuidPrefix)0102">
        <File Id="FileDllX86" Source="$(var.StageDir)\x86\qiqiime.dll" KeyPath="yes" />
        <File Id="FileSettingsExeX86" Source="$(var.StageDir)\x86\QiQiIMESettings.exe" />
        <File Id="FileLogMonitorExeX86" Source="$(var.StageDir)\x86\QiQiIMELogMonitor.exe" />
        <File Id="FileDictManagerExeX86" Source="$(var.StageDir)\x86\QiQiIMEDictManager.exe" />
      </Component>

      <!-- Shared dictionaries (and cleanup rule for prebuilt .qdict binary caches generated during registration) -->
      <Component Id="CmpSharedData" Directory="DirData" Guid="$(var.ComponentGuidPrefix)0103">
        <File Id="FileDictJidian" Source="$(var.StageDir)\data\wubi86_jidian.txt" KeyPath="yes" />
        <File Id="FileDictJidianExtra" Source="$(var.StageDir)\data\wubi86_jidian_extra.txt" />
        <File Id="FileDictHaifeng" Source="$(var.StageDir)\data\wubi86_haifeng.txt" />
        <RemoveFile Id="RemovePrebuiltQdict" Name="*.qdict" On="uninstall" />
      </Component>

      <!-- Management scripts -->
      <Component Id="CmpScripts" Directory="DirScripts" Guid="$(var.ComponentGuidPrefix)0104">
        <File Id="FileCommonPs1" Source="$(var.StageDir)\scripts\common.ps1" KeyPath="yes" />
        <File Id="FileRegisterPs1" Source="$(var.StageDir)\scripts\register_ime.ps1" />
        <File Id="FileUnregisterPs1" Source="$(var.StageDir)\scripts\unregister_ime.ps1" />
      </Component>

      <!-- License and documentation -->
      <Component Id="CmpDocs" Directory="INSTALLFOLDER" Guid="$(var.ComponentGuidPrefix)0105">
        <File Id="FileLicense" Source="$(var.StageDir)\LICENSE" KeyPath="yes" />
        <File Id="FileReadme" Source="$(var.StageDir)\README.md" />
        <File Id="FileReadmeChinese" Source="$(var.StageDir)\README.zh-CN.md" />
        <File Id="FilePrivacy" Source="$(var.StageDir)\PRIVACY.md" />
        <File Id="FileCodeSigning" Source="$(var.StageDir)\CODE_SIGNING.md" />
        <File Id="FileThirdPartyNotices" Source="$(var.StageDir)\THIRD_PARTY_NOTICES.md" />
        <File Id="FileDeployment" Source="$(var.StageDir)\deploy.md" />
        <File Id="FileLogging" Source="$(var.StageDir)\log.md" />
        <File Id="FileReleaseNotes" Source="$(var.StageDir)\release-notes.md" />
      </Component>

      <Component Id="CmpLicenses" Directory="DirLicenses" Guid="$(var.ComponentGuidPrefix)0107">
        <File Id="FileApacheLicense" Source="$(var.StageDir)\licenses\Apache-2.0.txt" KeyPath="yes" />
        <File Id="FileJidianMitLicense" Source="$(var.StageDir)\licenses\rime-wubi86-jidian-MIT.txt" />
        <File Id="FileHaifengLicense" Source="$(var.StageDir)\licenses\wubi-haifeng-BSD-3-Clause.txt" />
        <File Id="FileGslLicense" Source="$(var.StageDir)\licenses\microsoft-gsl-MIT.txt" />
      </Component>

      <Component Id="CmpStartMenuShortcuts" Directory="QiQiProgramMenuFolder"
                 Guid="$(var.ComponentGuidPrefix)0106" Bitness="$(var.ShortcutBitness)">
        <Shortcut Id="SettingsShortcut"
                  Name="!(loc.SettingsShortcutName)"
                  Description="!(loc.SettingsShortcutDescription)"
                  Target="[#FileSettingsExe$(var.NativeFileSuffix)]" WorkingDirectory="$(var.NativeDirectory)"
                  Icon="ProductIcon" IconIndex="0" Advertise="no" />
        <Shortcut Id="DictManagerShortcut"
                  Name="!(loc.DictManagerShortcutName)"
                  Description="!(loc.DictManagerShortcutDescription)"
                  Target="[#FileDictManagerExe$(var.NativeFileSuffix)]" WorkingDirectory="$(var.NativeDirectory)"
                  Icon="DictManagerIcon" IconIndex="0" Advertise="no" />
        <Shortcut Id="LogMonitorShortcut"
                  Name="!(loc.LogMonitorShortcutName)"
                  Description="!(loc.LogMonitorShortcutDescription)"
                  Target="[#FileLogMonitorExe$(var.NativeFileSuffix)]" WorkingDirectory="$(var.NativeDirectory)"
                  Icon="LogMonitorIcon" IconIndex="0" Advertise="no" />
        <RemoveFolder Id="RemoveQiQiProgramMenuFolder" On="uninstall" />
        <!-- HKMU resolves to HKLM for this per-machine package and satisfies ICE43. -->
        <RegistryValue Root="HKMU" Key="Software\QiQiIME\Installer"
                       Name="StartMenuShortcuts" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="!(loc.FeatureTitle)" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <!-- Grant AppContainer / Restricted AppContainer read & execute access on installation folder -->
    <CustomAction Id="GrantAppContainerAcl"
                  Directory="INSTALLFOLDER"
                  Execute="deferred"
                  Impersonate="no"
                  ExeCommand="[$(var.NativeSystemDirectory)]icacls.exe &quot;[INSTALLFOLDER].&quot; /grant &quot;*S-1-15-2-1:(OI)(CI)(RX)&quot; /grant &quot;*S-1-15-2-2:(OI)(CI)(RX)&quot; /Q"
                  Return="ignore" />

    <!-- Deferred elevated CustomActions to register/unregister x64 and x86 TSF Text Services -->
    <?if $(sys.BUILDARCH) = x64 ?>
    <CustomAction Id="RegX64"
                  Directory="DirX64"
                  Execute="deferred"
                  Impersonate="no"
                  ExeCommand="[System64Folder]regsvr32.exe /s &quot;[DirX64]qiqiime.dll&quot;"
                  Return="check" />
    <?endif?>

    <CustomAction Id="RegX86"
                  Directory="DirX86"
                  Execute="deferred"
                  Impersonate="no"
                  ExeCommand="[SystemFolder]regsvr32.exe /s &quot;[DirX86]qiqiime.dll&quot;"
                  Return="check" />

    <!-- Only enable the initiating user's profile; do not repeat machine registration. -->
    <CustomAction Id="EnableUserProfile"
                  Directory="$(var.NativeDirectory)"
                  Execute="deferred"
                  Impersonate="yes"
                  ExeCommand="[$(var.NativeSystemDirectory)]regsvr32.exe /s /n /i:user &quot;[$(var.NativeDirectory)]qiqiime.dll&quot;"
                  Return="check" />

    <!-- Deactivate the initiating user's TSF profile in their interactive session before InstallValidate checks file locks -->
    <CustomAction Id="DeactivateUserProfile"
                  Directory="$(var.NativeDirectory)"
                  Execute="immediate"
                  Impersonate="yes"
                  ExeCommand="[$(var.NativeSystemDirectory)]regsvr32.exe /s /u /n /i:user &quot;[$(var.NativeDirectory)]qiqiime.dll&quot;"
                  Return="ignore" />

    <CustomAction Id="UnregX86"
                  Directory="DirX86"
                  Execute="deferred"
                  Impersonate="no"
                  ExeCommand="[SystemFolder]regsvr32.exe /u /s &quot;[DirX86]qiqiime.dll&quot;"
                  Return="ignore" />

    <!-- A cached embedded EXE remains available after RemoveFiles; never run cleanup as SYSTEM. -->
    <Binary Id="UserDataCleaner" SourceFile="$(var.StageDir)\$(var.NativeFileSuffix)\QiQiIMESettings.exe" />
    <CustomAction Id="RemoveUserData"
                  BinaryRef="UserDataCleaner"
                  Execute="commit"
                  Impersonate="yes"
                  ExeCommand="--remove-user-data"
                  Return="check" />

    <?if $(sys.BUILDARCH) = x64 ?>
    <CustomAction Id="UnregX64"
                  Directory="DirX64"
                  Execute="deferred"
                  Impersonate="no"
                  ExeCommand="[System64Folder]regsvr32.exe /u /s &quot;[DirX64]qiqiime.dll&quot;"
                  Return="ignore" />
    <?endif?>

    <InstallExecuteSequence>
      <Custom Action="RemoveUserData" Before="InstallFinalize"
              Condition="Installed AND REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND QIQI_REMOVE_USER_DATA=&quot;1&quot;" />
      <Custom Action="DeactivateUserProfile" Before="InstallValidate" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="GrantAppContainerAcl" After="InstallFiles" Condition="NOT Installed OR REINSTALL" />
      <?if $(sys.BUILDARCH) = x64 ?>
        <Custom Action="RegX64" After="GrantAppContainerAcl" Condition="NOT Installed OR REINSTALL" />
        <Custom Action="RegX86" After="RegX64" Condition="NOT Installed OR REINSTALL" />
      <?else?>
        <Custom Action="RegX86" After="GrantAppContainerAcl" Condition="NOT Installed OR REINSTALL" />
      <?endif?>
      <Custom Action="EnableUserProfile" After="RegX86" Condition="NOT Installed OR REINSTALL" />
      <Custom Action="UnregX86" After="InstallInitialize" Condition="REMOVE=&quot;ALL&quot;" />
      <?if $(sys.BUILDARCH) = x64 ?>
        <Custom Action="UnregX64" After="UnregX86" Condition="REMOVE=&quot;ALL&quot;" />
      <?endif?>
    </InstallExecuteSequence>
  </Package>
</Wix>

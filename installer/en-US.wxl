  <String Id="ProductName" Value="QiQi Wubi IME" />
  <String Id="SummaryDescription" Value="QiQi Wubi 86 TSF Input Method Editor ($(sys.BUILDARCH)) v$(var.ProductVersion)" />
  <String Id="X86Requires32BitWindows" Value="This x86 installer requires 32-bit Windows. On 64-bit Windows, use the x64 installer, which includes support for 32-bit applications." />
  <String Id="SummaryComments" Value="Copyright (C) 2026 cloudfyy. Licenses: Core GPL-3.0-or-later; Jidian Wubi Dict Apache-2.0; Haifeng Wubi Dict BSD-3-Clause." />
  <String Id="SummaryKeywords" Value="QiQiIME, QiQi Wubi, Wubi, TSF, Input Method, IME, GPL-3.0-or-later" />
  <String Id="DowngradeErrorMessage" Value="A newer version of QiQi Wubi IME is already installed." />
  <String Id="FeatureTitle" Value="QiQi Wubi 86 Input Method" />
  <String Id="UninstallDescription" Value="QiQi Wubi IME will be removed. Personal settings and user dictionaries are kept by default for future installations." />
  <String Id="RemoveUserData" Value="Also delete this user's settings and default user dictionary" />
  <String Id="RemoveUserDataWarning" Value="Selected data is deleted permanently: this user's settings, default dictionary, frequencies and known cache/sync files. Custom paths, exports, backups and other users are preserved. Close IME applications and back up first." />
  <String Id="UninstallButton" Value="Uninstall" />
  <String Id="CancelButton" Value="Cancel" />
  <String Id="SettingsShortcutName" Value="QiQiIME Settings" />
  <String Id="SettingsShortcutDescription" Value="Configure QiQi Wubi IME." />
  <String Id="DictManagerShortcutName" Value="QiQiIME Dict Manager" />
  <String Id="DictManagerShortcutDescription" Value="Manage QiQiIME user dictionary entries and backups." />
  <String Id="LogMonitorShortcutName" Value="QiQiIME Log Monitor" />
  <String Id="LogMonitorShortcutDescription" Value="View and export QiQiIME diagnostic logs." />
